{
  "name": "guesant-lobby",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "cd .. && node .config/scripts/quality.ts lint",
    "lint:fix": "cd .. && node .config/scripts/quality.ts lint-fix",
    "lighthouse:baseline": "cd .. && node .config/scripts/lighthouse-baseline.ts",
    "format": "cd .. && node .config/scripts/quality.ts format",
    "format-fix": "cd .. && node .config/scripts/quality.ts format-fix",
    "test:quality": "cd .. && .config/node_modules/.bin/vitest run --config .config/vitest.config.ts --root . .config/scripts/check-code-spacing.test.ts"
  },
  "dependencies": {
    "entities": "^9.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.5.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
